# Postgres (Neon): chat budget, visitor limits, interview requests
DATABASE_URL=

# Jasmin's public chat: any OpenAI-compatible endpoint. Default: fal's OpenRouter
# route, billed to the fal account (CHAT_API_KEY = the fal key).
CHAT_BASE_URL=https://fal.run/openrouter/router/openai/v1
CHAT_API_KEY=
CHAT_MODEL=google/gemini-2.5-flash
# USD per 1M tokens, used when the endpoint does not report the cost itself
CHAT_PRICE_IN=0.30
CHAT_PRICE_OUT=2.50
# Hard daily spend cap for the whole site, in USD
CHAT_DAILY_CAP_USD=1
# Messages per visitor per day
CHAT_VISITOR_LIMIT=20
# Random secret for hashing visitor IPs
VISITOR_SALT=

# Interview requests: Telegram notification to Gasan
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Signs the Approve/Decline links (random)
INTERVIEW_SECRET=
